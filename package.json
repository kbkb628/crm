{
  "name": "pi-native-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Native CRM — CRM self-hosted, multi-tenant e LGPD by-design com execução de agentes baseada no Pi Agent Core.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "demo:seed": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "ai:agents:ensure-builtins": "tsx --env-file=.env --env-file=.env.local scripts/ensure-builtin-agents.ts",
    "build": "next build",
    "build:webpack": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:reset": "supabase db reset",
    "lint:channels": "tsx scripts/lint-channels.ts",
    "lint:role-rank": "tsx scripts/lint-role-rank.ts",
    "checar:colisao-de-migration": "bash scripts/checar-colisao-de-migration.sh",
    "gov:verify": "pnpm typecheck && pnpm lint && pnpm lint:channels && pnpm lint:role-rank",
    "worker": "tsx --env-file=.env --env-file=.env.local workers/agent-worker/main.ts",
    "dev:crons": "tsx --env-file=.env --env-file=.env.local scripts/dev-crons.ts",
    "flywheel:judge": "tsx --env-file=.env --env-file=.env.local scripts/flywheel-judge-live.ts",
    "eval:customer-memory": "tsx scripts/eval-customer-memory.ts"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./app/globals.css"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.21",
    "@upstash/redis": "^1.39.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.1.0",
    "import-in-the-middle": "^3.5.2",
    "ipaddr.js": "^2.5.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "10.1.7",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-hotkeys-hook": "^5.3.3",
    "recharts": "^3.10.1",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.12.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "//overrides": "Pisos de versão para dependência TRANSITIVA com advisory. Não é atalho: `pnpm update <pkg>` só casa o padrão contra o package.json (hono/js-yaml/nanoid não estão lá, e não se movem), e `pnpm update` sem alvo reescreve 29 ranges diretas e arrasta 139 pacotes. Override é a única ferramenta que move transitiva sem arrastar o mundo. Os seletores com `@<major>` são LOAD-BEARING: o lock tem duas árvores de brace-expansion (1.x e 5.x) e duas de path-to-regexp (6.x e 8.x); sem o escopo, o override rebaixa a árvore nova para a antiga — em silêncio, com `pnpm audit` ainda verde.",
    "overrides": {
      "postcss": "^8.5.31",
      "sharp": "^0.35.0",
      "hono": "^4.12.34",
      "js-yaml": "^4.3.1",
      "brace-expansion@1": "^1.1.18",
      "path-to-regexp@6": "^6.3.0",
      "fast-uri": "^3.1.7",
      "qs": "^6.16.0",
      "browserslist": "^4.28.8"
    },
    "patchedDependencies": {
      "@react-pdf/hyphenate": "patches/@react-pdf__hyphenate.patch"
    }
  }
}
